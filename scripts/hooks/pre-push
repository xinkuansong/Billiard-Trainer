#!/bin/sh
# 内容不变量门禁（问题集合 v29 W9；真源 .kiro/steering/content-data-contract.md §7）
#
# 阻塞项：C1 出片新鲜度 / C2 回填一致性 / C3 引用指向（含失效引用棘轮）/
#         C4 结构对齐 / I5 精讲 token / I6a 剂量 token / I6b sequence 型每轮球数 /
#         I7 profile / I8 Bundle 子集 / I9 序列覆盖 / I10 模型可解码性 / I11 官方计划校验
# （v26 W13：C4 已转正为阻塞；GATE_EXEMPT_CHECKS 为空。v31 W4：I6a/I6b/I11 接入）
#
# 安装：make -f scripts/Makefile install-hooks
# 绕过：git push --no-verify（git 内置，无法在钩子里禁掉；用了就必须在 PR/日志里说明理由）

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "→ [pre-push] 内容不变量门禁 ..."
if ! python3 "$REPO_ROOT/scripts/verify_tutorial_sync.py" --gate; then
  cat <<'EOF'

⛔ push 被拦截：内容不变量门禁未通过（上方 ✗ 为违规项）。

处置顺序：
  1. C1/C2 失败 → 重出片并回填：make position-export → import-engine-export-to-app.py → make tryout-sync
  2. C3 基线被突破 → 修好新增的失效 image 引用（不得直接上调基线）
  3. C4 失败 → 精讲逐杆节数 / 球形数与序列对齐（红线：改精讲，不改序列）
  4. I5/I7 失败 → 精讲 / profile 与序列 token 对齐（红线：改精讲，不改序列）
  5. I8 失败 → make tryout-sync（Bundle 是派生物，禁止手改）
  6. I9 失败 → 录制序列，或按契约 §8.5 登记豁免后写入 scripts/content_invariant_baselines.json
  7. I6a/I6b 失败 → drill JSON 的 sets.perFormation 与序列对齐（红线：改剂量，不改序列）
  8. I10 失败 → 按 codingPath 补齐必填字段 / 修类型；改过 Swift 模型则同步 MODEL_SPEC
  9. I11 失败 → 官方计划的 drillId / dose / 球形 token 对齐内容（token 是计划外键，契约 §6.6）

自查命令：make -f scripts/Makefile verify-gate
EOF
  exit 1
fi
echo "✅ [pre-push] 内容不变量门禁通过"

echo "→ [pre-push] 进度文档体积门禁 ..."
if ! python3 "$REPO_ROOT/scripts/verify_doc_size.py"; then
  cat <<'EOF'

⛔ push 被拦截：进度文档超出滚动归档纪律（上方 ✗ 为违规项）。

处置：把 PROGRESS.md「当前状态」/ hub 状态卡「最近完成」中最旧的条目
移入对应归档文件（tasks/archive/ / project-hub projects/archive/），
保持滚动区 ≤ 10 条。⛔ 禁止上调 verify_doc_size.py 阈值放行。

自查命令：make -f scripts/Makefile verify-doc-size
EOF
  exit 1
fi
echo "✅ [pre-push] 进度文档体积门禁通过"
