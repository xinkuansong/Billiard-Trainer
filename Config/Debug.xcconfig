CUEPHYS_ENTITLEMENTS = CuePhys/CuePhys.entitlements
// Debug.xcconfig
// 占位示例 — 将真实密钥写入 Config/Secrets.xcconfig（已加入 .gitignore，不提交 Git）
// 新开发者：复制此文件为 Secrets.xcconfig，填入真实值

// 自建后端 API；正式 HTTPS 已完成公网验收。
// xcconfig 中 // 会被当作注释，用 $() 空变量打断双斜杠
API_BASE_URL = https:/$()/api.cuephys.com

LEGAL_TERMS_URL = https:/$()/youbilliards.com/legal/cuephys-terms/
LEGAL_PRIVACY_URL = https:/$()/youbilliards.com/legal/cuephys-privacy/

// WeChat（H-05 完成后填入）
WECHAT_APP_ID = YOUR_WECHAT_APP_ID_HERE
WECHAT_UNIVERSAL_LINK = https:/$()/yourdomain.com/wechat/
