              "spinX": 0,
              "spinY": 0,
              "velocity": 1.2000000000000002
            },
            "content": "",
            "items": [
              {
                "label": "自检",
                "text": "中袋打厚不是慢进袋，是直接撞库弹开——没有角袋那种贴着进的余地。"
              }
            ],
            "image": "drill_c053_manual01_s02",
