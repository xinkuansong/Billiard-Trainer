  "tutorial": {
    "tutorialKind": "multiShot",
    "formations": [
      {
        "id": "A1",
        "sections": [
          {
            "content": "本球形切角 45°、R切、无塞、中杆。无塞对照：只有切角，无侧旋投掷。本球形无塞对照：瞄准接触点本身，感受纯切角进袋。挤偏与力度无关——力度只影响走位与洗袋风险，不改变让点方向。",
            "title": "技术原理"
          },
          {
            "content": "中心击球，瞄准正确接触点出杆；先建立无塞基准手感。力度约 3.0 m/s。目标只有 8 号进下中袋，不必管母球停哪。",
            "title": "怎么打"
          },
          {
            "content": "达标：本球形 10 球进 6 球（仅计目标球进袋）。若目标球系统性偏一侧，先分清是让点方向反了，还是顺/反塞搞反；若母球跟进落袋，略减力或确认目标球距袋不要过近。",
            "title": "自检"
          }
        ],
        "title": "A1 · 45°·无塞·R切"
      },
      {
        "id": "A2",
        "sections": [
          {
            "content": "本球形切角 45°、R切、右塞（|spinX|=0.30R）、中杆。顺塞：塞侧与切侧同侧，投掷通常让目标球变厚。右塞使母球出射偏向左侧（挤偏），瞄准须向右让点补偿（W1）。挤偏与力度无关——力度只影响走位与洗袋风险，不改变让点方向。",
            "title": "技术原理"
          },
          {
            "content": "按档位加右塞，瞄准时向右让开一点再出杆；力度约 3.0 m/s。目标只有 8 号进下中袋，不必管母球停哪。",
            "title": "怎么打"
          },
          {
            "content": "达标：本球形 10 球进 6 球（仅计目标球进袋）。若目标球系统性偏一侧，先分清是让点方向反了，还是顺/反塞搞反；若母球跟进落袋，略减力或确认目标球距袋不要过近。",
            "title": "自检"
          }
        ],
        "title": "A2 · 45°·顺塞·R切"
