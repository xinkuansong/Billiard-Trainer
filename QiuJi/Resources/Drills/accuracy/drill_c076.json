    "formations": [
      {
        "id": "manual01",
        "title": "球形1：左侧中袋·左右塞对打",
        "sections": [
          {
            "title": "技术原理",
            "content": "塞量阶梯已经把让点方向立住。这组在中袋上叠小角度：同一档切角对打半颗皮头左塞、右塞，练中袋小角度加塞准度，并看左右塞吃库后母球线路怎么分开。只验 8 号进袋。"
          },
          {
            "title": "开局与击球顺序",
            "content": "- **目标球**：8 号\n- **目标袋**：左侧中袋\n- **球袋距离**：约 45 公分\n- **杆法**：中杆，半颗皮头左塞 / 右塞对打\n- **力度**：小力\n- **训练档位**：14 档，每档打完重置\n- **切角**：从约 28° 收到直线，再打开到约 17°（每档见配图）",
            "image": "drill_c076_manual01_initial",
            "caption": "球形1开局：8 号打左侧中袋，左右塞对打"
          },
          {
            "title": "第一杆：8号球 · 左侧中袋",
            "params": {
              "spinX": 0.24833635503849066,
              "spinY": -0.00011721578445539858,
              "velocity": 1.5
            },
            "content": "",
            "items": [
              {
                "label": "为什么",
                "text": "开档左塞。先确认这个切角上，让点方向跟塞侧对得上。"
              },
              {
                "label": "怎么打",
                "text": "半颗皮头左塞，让点向左。"
              },
              {
                "label": "自检",
                "text": "左塞却擦右侧袋唇，就是让点没往左让。"
              }
            ],
            "image": "drill_c076_manual01_s01",
            "caption": "第1杆：约 28° · 左塞"
