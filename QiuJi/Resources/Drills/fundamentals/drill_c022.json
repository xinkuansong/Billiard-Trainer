          {
            "title": "第一杆：1号球 · 右下角袋",
            "params": {
              "spinX": 0,
              "spinY": 0,
              "velocity": 1.4
            },
            "content": "",
            "items": [
              {
                "label": "为什么",
                "text": "先用小力把远台线打直，给下一档当对照。"
              },
              {
                "label": "怎么打",
                "text": "中杆、小力，空杆确认再实打。"
              },
              {
                "label": "自检",
                "text": "1 号进袋。这一档都不稳，先别加力。"
              }
            ],
            "image": "drill_c022_Snipaste_2026_06_02_00_22_05_s01",
            "caption": "第1杆：约 2°"
          },
