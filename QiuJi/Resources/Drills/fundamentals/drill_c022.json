    "formations": [
      {
        "id": "f1",
        "title": "球形A：远台直线一杆",
        "sections": [
          {
            "title": "技术原理",
            "content": "「直线出杆」里已经练过出杆走直。这组把距离拉到远台，侧偏会被放大。球形 A 先用一杆把远台线定住。"
          },
          {
            "title": "开局与击球顺序",
            "content": "- **目标球**：1 号\n- **目标袋**：右下角袋\n- **两球距离**：约 1.3 米\n- **杆法**：中低杆\n- **力度**：小力\n- **为什么这样排**：远台直线，一点点侧向就会在袋口现形",
            "image": "drill_c022_Snipaste_2026_06_02_00_19_36_initial",
            "caption": "球形A开局：远台直线，1 号进右下角袋"
          },
          {
            "title": "第一杆：1号球 · 右下角袋",
            "params": {
              "spinX": 0.0017368814770112439,
              "spinY": -0.17765704824426126,
              "velocity": 2.1
            },
            "content": "",
            "items": [
              {
                "label": "为什么",
                "text": "远台把出杆侧偏放大，先求线直，不求力大。"
              },
              {
                "label": "怎么打",
                "text": "视线、球杆、目标三点一线，先空杆再实打。中低杆、小力送透。"
              },
              {
                "label": "自检",
                "text": "1 号进右下角袋。偏同一侧 = 远台把近台看不出的弧放大了，先修出杆，不加力。"
              }
            ],
            "image": "drill_c022_Snipaste_2026_06_02_00_19_36_s01",
            "caption": "第1杆：约 3°"
          },
          {
            "title": "常见错误与纠正",
            "content": "",
            "items": [
              {
                "label": "远了就加力",
                "text": "加力只会把侧偏送得更远。先把小力打直。"
              },
              {
                "label": "反复偏同一侧",
                "text": "查握杆手腕和站位有没有习惯性偏转，不要用打点去补。"
              }
            ]
          },
          {
            "title": "进阶练习",
            "content": "球形 A 能进之后，换球形 B，同一条线对比小力和中力。"
          }
        ]
      },
      {
        "id": "f2",
        "title": "球形B：远台两档力度",
        "sections": [
          {
            "title": "技术原理",
            "content": "还是远台直线。这一形同一摆位先小力再中力，看加力后出杆还能不能走直。"
          },
          {
            "title": "开局与击球顺序",
            "content": "- **目标球**：1 号\n- **目标袋**：右下角袋\n- **两球距离**：约 1.3 米\n- **杆法**：中杆\n- **力度**：小力 → 中力，两档独立重置\n- **为什么这样排**：距离钉死，只加力，看侧偏会不会一起被放大",
            "image": "drill_c022_Snipaste_2026_06_02_00_22_05_initial",
            "caption": "球形B开局：同一远台线，两档力度"
