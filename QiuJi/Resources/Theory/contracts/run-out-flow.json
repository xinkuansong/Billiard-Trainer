            "next_state_for_next_shot": "step_1_survey",
            "policy": "重做（整局重启）"
          },
          {
            "condition": "table_changed_significantly (e.g., new cluster created)",
            "next_state_for_next_shot": "step_1_survey",
            "policy": "强制重做 Survey"
          }
        ]
