# Large drill videos (handled via Git LFS / OTA later, not in git history)
QiuJi/Resources/Videos/

# Retired engine-rendered demo videos: 11 GB moved out of Resources/ so xcodegen
# can never sweep them into the bundle again (v25 D-v25-1). Kept on disk, not
# deleted (v25 red line 6). Resources/Videos/ now holds only real-person takes.
archive/

# Tutorial figure MASTERS: 4.9 GB of lossless PNG (1343 frames incl. orphans).
# Masters stay on disk only — never in git, never in the bundle (D-v25-10).
# What ships and what enters git is QiuJi/Resources/TutorialFigures/ (710 HEIC,
# 112 MB), published from these masters by `make tutorial-figures` (v25 W4,
# D-v25-2 / D-v25-14). Two directories because a folder reference packages the
# whole directory — masters and shipped figures cannot share one.
QiuJi/Resources/DrillTutorials/*.png

# Engine preview frames: 520 MB, excluded from the app bundle (v25 D-v25-7).
QiuJi/Resources/Previews/

# Python bytecode from scripts/ tooling
__pycache__/

