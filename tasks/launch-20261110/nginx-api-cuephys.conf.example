# 候选配置：仅在 api.cuephys.com DNS 和证书都准备好后部署。
# 不要直接覆盖现有 youbilliards.com 配置。

server {
    listen 80;
    listen [::]:80;
    server_name api.cuephys.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.cuephys.com;

    ssl_certificate /etc/letsencrypt/live/api.cuephys.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.cuephys.com/privkey.pem;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
