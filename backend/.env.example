# MongoDB
MONGODB_URI=mongodb://qiujiApp:<password>@127.0.0.1:27017/qiuji?authSource=qiuji

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# Apple Sign In — 必须等于 App 的 Bundle ID（project.yml 的 PRODUCT_BUNDLE_IDENTIFIER）
APPLE_BUNDLE_ID=com.xinkuan.qiuji

# Server
PORT=3000
NODE_ENV=production

# Persistent avatar directory (must survive deployments and be backed up)
AVATAR_STORAGE_DIR=/var/lib/qiuji/avatars

# Legal pages return 503 until all production facts are filled and publishing is enabled.
LEGAL_DOCUMENTS_PUBLISHED=false
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=feedback@qiuji.app
LEGAL_EFFECTIVE_DATE=2026-09-03
LEGAL_INFRASTRUCTURE_PROVIDER=
LEGAL_DATA_REGION=
LEGAL_BACKUP_RETENTION_DAYS=
