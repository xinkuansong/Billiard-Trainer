# MongoDB
MONGODB_URI=mongodb://qiujiApp:<password>@127.0.0.1:27017/qiuji?authSource=qiuji

# A separate explicit MongoDB database (replica set), excluded from business restore.
# Provision with backend/src/scripts/initDeletionLedger.js on the verified live baseline.
DELETION_LEDGER_URI=
# Existing private persistent directory, outside avatar and database restore paths.
DELETION_CHECKPOINT_DIR=

# Generate each independently, e.g. openssl rand -hex 32. Existing installations
# must retain their valid keys to keep current sessions working.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Apple Sign In — 必须等于 App 的 Bundle ID（project.yml 的 PRODUCT_BUNDLE_IDENTIFIER）
APPLE_BUNDLE_ID=com.xinkuan.qiuji
# Sign in with Apple key, stored outside the app/repository.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIGNIN_KEY_PATH=
# Independent stable AES-256 key (64 hex characters); retain with server secrets.
APPLE_TOKEN_ENCRYPTION_KEY=


# WeChat mobile app OAuth (server-only secret)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Server
PORT=3000
NODE_ENV=production

# Persistent avatar directory (must survive deployments and be backed up)
AVATAR_STORAGE_DIR=/var/lib/qiuji/avatars

# Legal pages return 503 until all production facts are filled and publishing is enabled.
LEGAL_DOCUMENTS_PUBLISHED=false
LEGAL_OPERATOR_NAME=无锡有球科技有限公司
LEGAL_CONTACT_EMAIL=contact@youbilliards.com
LEGAL_EFFECTIVE_DATE=2026-09-03
LEGAL_INFRASTRUCTURE_PROVIDER=
LEGAL_DATA_REGION=
LEGAL_BACKUP_RETENTION_DAYS=
