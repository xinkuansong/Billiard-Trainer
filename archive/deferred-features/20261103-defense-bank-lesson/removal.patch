-    private func strikePosition(cue: SCNVector3) -> SCNVector3 {
-        guard let aim = lastAimDirection else { return cue }
-        return CueStroke.strikePosition(cue: cue, aim: aim, spinX: spinX, spinY: spinY)
-    }
