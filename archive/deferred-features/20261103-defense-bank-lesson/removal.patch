-    @discardableResult
-    func acceptCompletePrediction(_ prediction: ShotPrediction) -> Bool {
-        guard prediction.hasFinalTableState else {
-            clearTrajectory()
-            scene.hideCueStick()
-            lastAimDirection = nil
-            setStatus("本次模拟未完成，请调整击球参数后重试", kind: .failure)
-            return false
-        }
-        return true
-    }
