-    private func aimDirection(path: [SCNVector3], from cue: SCNVector3) -> SCNVector3? {
-        for pt in path {
-            let dx = pt.x - cue.x, dz = pt.z - cue.z
-            let d = sqrtf(dx * dx + dz * dz)
-            if d > 0.02 { return SCNVector3(dx / d, 0, dz / d) }
-        }
-        return nil
-    }
